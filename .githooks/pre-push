#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

if [[ "${SKIP_DEPLOY:-}" == "1" || "${SKIP_DEPLOY:-}" == "true" ]]; then
  echo "pre-push: SKIP_DEPLOY set, skipping build and deployment."
  exit 0
fi

echo "pre-push: running build + deployments..."

if [[ "${SKIP_BUILD:-}" != "1" && "${SKIP_BUILD:-}" != "true" ]]; then
  (cd "$ROOT" && make build)
fi

if [[ "${SKIP_EAS:-}" != "1" && "${SKIP_EAS:-}" != "true" ]]; then
  APP_DIR="$ROOT/app"
  EAS_CMD="${EAS_CMD:-eas}"

  if ! command -v "${EAS_CMD%% *}" >/dev/null 2>&1; then
    if command -v npx >/dev/null 2>&1; then
      EAS_CMD="npx eas-cli"
    else
      echo "pre-push: eas-cli not found. Install it or set SKIP_EAS=1."
      exit 1
    fi
  fi

  EAS_PLATFORM="${EAS_PLATFORM:-all}"
  EAS_CHANNELS="${EAS_CHANNELS:-internal,development,preview}"
  EAS_MESSAGE="${EAS_MESSAGE:-$(git log -1 --pretty=%s)}"

  IFS=',' read -r -a channels <<< "$EAS_CHANNELS"
  for channel in "${channels[@]}"; do
    channel="$(echo "$channel" | xargs)"
    if [[ -z "$channel" ]]; then
      continue
    fi
    (
      cd "$APP_DIR"
      EAS_NO_VCS=1 EAS_NON_INTERACTIVE=1 \
        $EAS_CMD update --platform "$EAS_PLATFORM" --channel "$channel" --message "$EAS_MESSAGE"
    )
  done
fi

if [[ -n "${DEPLOY_CMD:-}" ]]; then
  (cd "$ROOT" && bash -lc "$DEPLOY_CMD")
fi

echo "pre-push: done."
