# Server Configuration
PORT=8080
ENVIRONMENT=development

# Cache Configuration
CACHE_TTL=5m

# Rate Limiting
RATE_LIMIT=100

# Error responses
# Set to true in development if you want error details in API responses for frontend logging.
EXPOSE_ERROR_DETAILS=true

# External APIs
FRANKFURTER_URL=https://api.frankfurter.app

# Database (PostgreSQL) - Required for user/wallet features
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# IRR Rate Crawler
IRR_CRAWLER_INTERVAL=5m
IRR_CRAWLER_ENABLED=true

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=change-me-in-production-to-a-secure-secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# LinkedIn OAuth
# Create an app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/linkedin/callback

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# AI Service
# Supported providers: cerebras, openai, googleai
# Cerebras (recommended - fast & free): https://cloud.cerebras.ai/
# OpenAI: https://platform.openai.com/api-keys
# Google AI: https://aistudio.google.com/app/apikey
AI_PROVIDER=cerebras
AI_API_KEY=
AI_CLOUD_PROJECT=
