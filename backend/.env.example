# Server Configuration
PORT=8080
ENVIRONMENT=development
METRICS_ENABLED=true

# HTTP server hardening
HTTP_READ_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=5m
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_HEADER_BYTES=1048576

# Cache Configuration
CACHE_TTL=5m

# Rate Limiting
RATE_LIMIT=100

# Error responses
# Set to true in development if you want error details in API responses for frontend logging.
EXPOSE_ERROR_DETAILS=true

# External APIs
FRANKFURTER_URL=https://api.frankfurter.app

# Database (Koyeb PostgreSQL) - Required for user/wallet features
# Format: postgres://user:password@host/dbname
DATABASE_URL=

# IRR Rate Crawler
IRR_CRAWLER_INTERVAL=5m
IRR_CRAWLER_ENABLED=true

# JWT Authentication
# IMPORTANT: Change this to a secure random string in production!
JWT_SECRET=change-me-in-production-to-a-secure-secret

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# LinkedIn OAuth
# Create an app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/linkedin/callback

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# AI Service
# Supported providers: groq, cerebras, openai, googleai
# Groq (recommended - fast & free tier): https://console.groq.com/keys
#   Text: llama-3.3-70b-versatile (128k context)
#   Vision: llama-3.2-90b-vision-preview
#   Audio: whisper-large-v3
# Cerebras: https://cloud.cerebras.ai/
# OpenAI: https://platform.openai.com/api-keys
# Google AI: https://aistudio.google.com/app/apikey
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
AI_THINKING_MODEL=
AI_THINKING_MODE_DEFAULT=auto
AI_VISION_MODEL=
AI_CLOUD_PROJECT=

# Qdrant Vector Database (for semantic memory)
# Enable to allow AI advisor to semantically recall past conversations and user preferences
QDRANT_ENABLED=false
QDRANT_URL=
QDRANT_API_KEY=

# Embedding Provider (supports: huggingface, ollama, googleai)
# HuggingFace (free, recommended): Get API key from https://huggingface.co/settings/tokens
# Ollama (local, free): Install Ollama and run `ollama pull nomic-embed-text`
# Google AI: Use AI_API_KEY above with text-embedding-004 model
EMBEDDING_PROVIDER=huggingface
EMBEDDING_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# For Ollama only (if EMBEDDING_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# Memory Settings
SHORT_TERM_MEMORY_TTL=24h
MAX_MEMORY_RESULTS=10
