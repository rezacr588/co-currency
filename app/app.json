{
  "expo": {
    "name": "CoFinance",
    "slug": "cofinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cofinance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cofinance.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of receipts and invoices",
        "NSPhotoLibraryUsageDescription": "Attach receipt photos from your library",
        "NSMicrophoneUsageDescription": "Record voice messages for the AI advisor"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f1a2a"
      },
      "package": "com.cofinance.app",
      "versionCode": 1,
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "RECORD_AUDIO"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidNavigationBar": {
      "visible": "immersive",
      "barStyle": "light-content",
      "backgroundColor": "#00000000"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-updates",
      "expo-navigation-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CoFinance to take photos of receipts and invoices",
          "photosPermission": "Allow CoFinance to access your photos for receipt uploads"
        }
      ],
      "expo-document-picker",
      [
        "expo-av",
        {
          "microphonePermission": "Allow CoFinance to record voice messages for the AI advisor"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://coai.koyeb.app/api/v1",
      "router": {},
      "eas": {
        "projectId": "517f2a2a-cc2a-4009-8878-c66dc9d7942a"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/517f2a2a-cc2a-4009-8878-c66dc9d7942a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "rez.zet.int"
  }
}
